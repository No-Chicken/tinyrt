 /* Package Type */
+/* Optional AOT mapping accounting. Configure only while no AOT module or load
+ * is alive, from the serialized runtime owner. Reserve runs before allocation;
+ * release balances every successful reservation, including allocation failure.
+ * Both callbacks must be NULL or both non-NULL; context must outlive all loads.
+ * Mapping sizes exclude platform rounding; host accounting must include it. */
+WASM_RUNTIME_API_EXTERN void
+wasm_runtime_set_aot_mapping_budget(bool (*reserve)(void *, uint32_t),
+                                    void (*release)(void *, uint32_t), void *ctx);
+
 typedef enum {
