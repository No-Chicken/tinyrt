             }
         }
 
-        if (comp_ctx->enable_thread_mgr) {
+        if (comp_ctx->enable_thread_mgr || comp_ctx->enable_loop_poll) {
             for (i = 0; i <= br_count; i++) {
                 target_block = get_target_block(func_ctx, br_depths[i]);
