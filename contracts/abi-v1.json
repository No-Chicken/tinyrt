  "events": {
    "TINYRT_TOUCH_RELEASE": 1,
    "TINYRT_CLOCK_EVENT": 2
  },
  "storage": {
    "keys": 16,
    "value": "i32"
  },
  "graphics": {
    "max_commands": 128,
    "text_max_bytes": 63,
    "text_box_font_px": [
      18,
      24,
      36,
      48
    ],
    "text_box_align": {
      "left": 0,
      "center": 1,
      "right": 2
    },
    "text_box": "single line, vertically centered, clipped to its rectangle",
    "arc": "outer radius; 0 degrees right, clockwise; 0 <= start <= end <= 360; full 0..360; equal angles empty",
    "rgb565": {
      "max_images": 1,
      "max_width": 256,
      "max_height": 240,
      "max_bytes": 122880,
      "format": "RGB565 little-endian packed bytes, owned copy, no scaling"
    },
    "skip": "DRAW/render only, sole render operation, preserves previous display; output count 0 invalidates other fields"
  },
  "clock": {
    "default_interval_ms": 100,
    "min_interval_ms": 1,
    "max_interval_ms": 1000,
    "stages": [
      "init",
      "event"
    ],
    "scheduling": "one next callback after completion, no catch-up loop"
  },
  "optional_input": {
    "import": "input_events",
    "allowed_masks": [
      0,
      56,
      64,
      120
    ],
    "init_only": true,
    "press": 3,
    "move": 4,
    "cancel": 5,
    "legacy_release": 1,
    "user_key": {
      "event": 6,
      "key_id": 1,
      "pressed_y": 1,
      "released_y": 0,
      "arg": 0,
      "power_key_exposed": false
    }
  },
  "resources": {
    "max_read_bytes": 4096,
    "stages": [
      "init",
      "event"
    ],
    "scope": "current authenticated package only",
    "permission": 0
  }
