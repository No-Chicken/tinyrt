 }
 
+void
+wasm_runtime_request_exec_env_termination(WASMExecEnv *exec_env)
+{
+    if (exec_env)
+        WASM_SUSPEND_FLAGS_FETCH_OR(exec_env->suspend_flags,
+                                   WASM_SUSPEND_FLAG_TERMINATE);
+}
+
+bool
+wasm_runtime_is_exec_env_terminated(WASMExecEnv *exec_env)
+{
+    return exec_env
+           && (WASM_SUSPEND_FLAGS_GET(exec_env->suspend_flags)
+               & WASM_SUSPEND_FLAG_TERMINATE) != 0;
+}
